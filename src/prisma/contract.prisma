// use prisma-next

enum post_type {
  @@type("pg/text@1")
  normal   = "normal"
  question = "question"
  alert    = "alert"
}

enum reaction_type {
  @@type("pg/text@1")
  like  = "like"
  love  = "love"
  haha  = "haha"
  wow   = "wow"
  sad   = "sad"
  angry = "angry"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String?   @unique
  phone    String?   @unique
  photo    String?
  username  String?
  password String?
  hashedPassword String?
  gender  String?
  posts     Post[]
  reactions Reaction[]
  comments  Comment[]
  commentReactions CommentReaction[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  type      post_type
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  reactions Reaction[]
  comments  Comment[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([authorId])
  @@index([type])
}

model Reaction {
  id        Int      @id @default(autoincrement())
  type      reaction_type
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  parentId  Int?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  reactions CommentReaction[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model CommentReaction {
  id        Int      @id @default(autoincrement())
  type      reaction_type
  comment   Comment  @relation(fields: [commentId], references: [id])
  commentId Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

