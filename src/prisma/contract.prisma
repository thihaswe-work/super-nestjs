// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String?   @unique
  phone    String?   @unique
  photo    String?
  username  String?
  password String?
  hashedPassword String?
  gender  String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

