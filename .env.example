# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.


DATABASE_URL="postgresql://postgres:@localhost:5432/super_db"

# --- Google OAuth (only needed if you switch to server-side redirect flow) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth (only needed if you switch to server-side redirect flow) ---
# developers.facebook.com -> My Apps -> Settings -> Basic
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Firebase (REQUIRED for the firebase provider) ---
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
# Paste the ENTIRE service account JSON on ONE line (keep \n literal inside private_key)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"}
FIREBASE_PROJECT_ID=your-project-id
